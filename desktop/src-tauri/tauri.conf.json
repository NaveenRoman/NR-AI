{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://127.0.0.1:8585/galaxy",
    "distDir": "http://127.0.0.1:8585/galaxy"
  },
  "package": {
    "productName": "NR-AI Desktop",
    "version": "1.0.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "Copyright (c) 2026 NR-AI Team",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "identifier": "com.nrai.desktop",
      "longDescription": "NR-AI Desktop Shell bridging local Galaxy UI with safe typed intent architecture.",
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": ""
      },
      "resources": [],
      "shortDescription": "NR-AI Desktop Shell",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8585; script-src 'self' 'unsafe-inline' http://127.0.0.1:8585; style-src 'self' 'unsafe-inline' http://127.0.0.1:8585; connect-src 'self' http://127.0.0.1:8585 ws://127.0.0.1:8585; img-src 'self' data: http://127.0.0.1:8585;",
      "dangerousRemoteUrlAccess": false
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": false,
        "execute": false,
        "sidecar": false
      },
      "fs": {
        "all": false
      },
      "http": {
        "all": false,
        "request": false
      },
      "window": {
        "all": true,
        "close": true,
        "hide": true,
        "maximize": true,
        "minimize": true,
        "show": true,
        "unmaximize": true,
        "unminimize": true
      }
    },
    "windows": [
      {
        "title": "NR-AI — Advanced Agentic Intelligence",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "http://127.0.0.1:8585/galaxy",
        "center": true,
        "decorations": true
      }
    ]
  }
}
